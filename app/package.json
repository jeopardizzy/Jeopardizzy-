{
  "name": "quizzical",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Quizzical — a fast, tactile trivia board game for the browser. Static, GitHub Pages ready.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "publish": "npm run build && node scripts/publish.mjs"
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.2.5",
    "@fontsource-variable/inter": "^5.2.5",
    "motion": "^14.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
